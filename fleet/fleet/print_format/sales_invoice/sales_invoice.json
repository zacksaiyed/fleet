 "doc_type": "Sales Invoice",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 14,
 "html": "<style>\n    /* ============================================================\n       A4 LANDSCAPE PAGE\n       ============================================================ */\n\n    @page {\n        size: A4 landscape;\n        margin: 7mm 5mm 7mm 5mm;\n    }\n\n    html,\n    body,\n    .print-format {\n        width: 100% !important;\n        margin: 0 !important;\n        padding: 0 !important;\n        font-family: Arial, Helvetica, sans-serif !important;\n        font-size: 9px !important;\n        line-height: 1.15 !important;\n        color: #222 !important;\n        background: #fff !important;\n    }\n\n    * {\n        box-sizing: border-box;\n    }\n\n    /* ============================================================\n       MAIN WRAPPER\n       ============================================================ */\n\n    .gps-stmt-wrapper {\n        width: 100%;\n        margin: 0;\n        padding: 0;\n    }\n\n    /* ============================================================\n       HEADER\n       ============================================================ */\n\n    .gps-stmt-header {\n        width: 100%;\n        display: flex;\n        justify-content: space-between;\n        align-items: flex-start;\n        margin-bottom: 5px;\n    }\n\n    .gps-company-info {\n        width: 75%;\n    }\n\n    .gps-company-name {\n        margin: 0;\n        padding: 0;\n        font-size: 17px;\n        line-height: 1.2;\n        font-weight: bold;\n    }\n\n    .gps-company-address {\n        margin-top: 2px;\n        font-size: 9px;\n        line-height: 1.2;\n    }\n\n    .gps-logo-wrapper {\n        width: 25%;\n        text-align: right;\n    }\n\n    .gps-logo {\n        max-width: 130px;\n        max-height: 55px;\n        width: auto;\n        height: auto;\n        object-fit: contain;\n    }\n\n    /* ============================================================\n       CLIENT INFORMATION\n       ============================================================ */\n\n    .gps-client-line {\n        width: 100%;\n        margin: 5px 0 7px 0;\n        padding: 3px 0;\n        font-size: 10px;\n    }\n\n    .gps-client-line b {\n        font-weight: bold;\n    }\n\n    /* ============================================================\n       SECTION TITLE\n       ============================================================ */\n\n    .gps-section-title {\n        width: 100%;\n        display: flex;\n        justify-content: space-between;\n        align-items: center;\n        margin: 7px 0 3px 0;\n        font-size: 10px;\n        font-weight: bold;\n    }\n\n    .gps-section-title-left {\n        text-align: left;\n    }\n\n    .gps-section-title-right {\n        text-align: right;\n        white-space: nowrap;\n    }\n\n    /* ============================================================\n       MAIN TABLE\n       ============================================================ */\n\n    table.gps-stmt-table {\n        width: 100% !important;\n        max-width: 100% !important;\n        border-collapse: collapse !important;\n        border-spacing: 0 !important;\n        table-layout: fixed !important;\n        margin: 0 0 10px 0;\n        page-break-inside: auto;\n    }\n\n    table.gps-stmt-table thead {\n        display: table-header-group;\n    }\n\n    table.gps-stmt-table tbody {\n        width: 100%;\n    }\n\n    table.gps-stmt-table tr {\n        page-break-inside: avoid;\n        page-break-after: auto;\n    }\n\n    table.gps-stmt-table th,\n    table.gps-stmt-table td {\n        border: 1px solid #333 !important;\n        padding: 2px 3px !important;\n        text-align: center;\n        vertical-align: middle;\n        overflow-wrap: anywhere;\n        word-break: break-word;\n    }\n\n    table.gps-stmt-table th {\n        background-color: #ffff00 !important;\n        font-weight: bold;\n        font-size: 8px;\n        line-height: 1.1;\n    }\n\n    table.gps-stmt-table td {\n        font-size: 8px;\n        line-height: 1.1;\n    }\n\n    table.gps-stmt-table td.left {\n        text-align: left;\n    }\n\n    /* ============================================================\n       FIXED COLUMN WIDTHS\n       ============================================================ */\n\n    table.gps-stmt-table th:nth-child(1),\n    table.gps-stmt-table td:nth-child(1) {\n        width: 4%;\n    }\n\n    table.gps-stmt-table th:nth-child(2),\n    table.gps-stmt-table td:nth-child(2) {\n        width: 10%;\n    }\n\n    table.gps-stmt-table th:nth-child(3),\n    table.gps-stmt-table td:nth-child(3) {\n        width: 10%;\n    }\n\n    table.gps-stmt-table th:nth-child(4),\n    table.gps-stmt-table td:nth-child(4) {\n        width: 8%;\n    }\n\n    table.gps-stmt-table th:nth-child(5),\n    table.gps-stmt-table td:nth-child(5) {\n        width: 7%;\n    }\n\n    table.gps-stmt-table th:nth-child(6),\n    table.gps-stmt-table td:nth-child(6) {\n        width: 7%;\n    }\n\n    /* ============================================================\n       TOTAL ROWS\n       ============================================================ */\n\n    tr.gps-total-row td {\n        background-color: #ffff00 !important;\n        font-weight: bold;\n    }\n\n    tr.gps-total-row td:first-child {\n        text-align: right;\n    }\n\n    tr.gps-vat-row td {\n        background-color: #ffff00 !important;\n        font-weight: bold;\n        text-align: right !important;\n    }\n\n    tr.gps-grandtotal-row td {\n        background-color: #ffff00 !important;\n        font-weight: bold;\n        text-align: right !important;\n        font-size: 9px;\n    }\n\n    /* ============================================================\n       PRINT HELPERS\n       ============================================================ */\n\n    .avoid-break {\n        page-break-inside: avoid !important;\n    }\n\n    .no-print {\n        display: none !important;\n    }\n</style>\n\n\n{# ================================================================\n   BILLING DATE RANGE\n   ================================================================ #}\n\n{%- set b_start = (\n    doc.custom_billing_start_date\n    or doc.custom_billing_from\n    or doc.posting_date\n) -%}\n\n{%- set b_end = (\n    doc.custom_billing_end_date\n    or doc.custom_billing_to\n    or doc.posting_date\n) -%}\n\n\n{# Convert Frappe date/string into Python date object #}\n\n{%- set start_date = frappe.utils.getdate(b_start) -%}\n\n{%- set end_date = frappe.utils.getdate(b_end) -%}\n\n\n{# ================================================================\n   YEAR / MONTH\n   ================================================================ #}\n\n{%- set sy = start_date.year -%}\n\n{%- set sm = start_date.month -%}\n\n{%- set ey = end_date.year -%}\n\n{%- set em = end_date.month -%}\n\n\n{# ================================================================\n   MONTH NAMES\n   ================================================================ #}\n\n{%- set month_names = [\n    \"Jan\",\n    \"Feb\",\n    \"Mar\",\n    \"Apr\",\n    \"May\",\n    \"Jun\",\n    \"Jul\",\n    \"Aug\",\n    \"Sep\",\n    \"Oct\",\n    \"Nov\",\n    \"Dec\"\n] -%}\n\n\n{# ================================================================\n   NUMBER OF MONTHS\n   ================================================================ #}\n\n{%- set total_months =\n    ((ey - sy) * 12 + (em - sm) + 1)\n    if ((ey > sy) or (ey == sy and em >= sm))\n    else 0\n-%}\n\n\n{# ================================================================\n   MONTH LIST\n   ================================================================ #}\n\n{%- set months = [] -%}\n\n\n{%- for i in range(\n    total_months if total_months < 60 else 60\n) -%}\n\n    {%- set abs_month_index = (sm - 1) + i -%}\n\n    {%- set yy = sy + (abs_month_index // 12) -%}\n\n    {%- set mm = (abs_month_index % 12) + 1 -%}\n\n\n    {%- set month_key =\n        month_names[mm - 1].lower()\n        ~ \"_\"\n        ~ (yy|string)[-2:]\n    -%}\n\n\n    {%- set month_label =\n        month_names[mm - 1]\n        ~ \"-\"\n        ~ (yy|string)[-2:]\n    -%}\n\n\n    {%- set _ = months.append({\n        \"key\": month_key,\n        \"label\": month_label\n    }) -%}\n\n{%- endfor -%}\n\n\n<div class=\"gps-stmt-wrapper\">\n\n\n    <!-- ============================================================\n         COMPANY HEADER\n         ============================================================ -->\n\n    <div class=\"gps-stmt-header\">\n\n        <div class=\"gps-company-info\">\n\n            <div class=\"gps-company-name\">\n                {{ doc.company or \"\" }}\n            </div>\n\n            <div class=\"gps-company-address\">\n                {{ doc.company_address_display or \"\" }}\n            </div>\n\n        </div>\n\n\n        {%- set logo = frappe.db.get_value(\n            \"Company\",\n            doc.company,\n            \"company_logo\"\n        ) -%}\n\n\n        {%- if logo -%}\n\n            <div class=\"gps-logo-wrapper\">\n\n                <img\n                    class=\"gps-logo\"\n                    src=\"{{ logo }}\"\n                    alt=\"{{ doc.company or '' }}\"\n                >\n\n            </div>\n\n        {%- endif -%}\n\n    </div>\n\n\n    <!-- ============================================================\n         CLIENT\n         ============================================================ -->\n\n    <div class=\"gps-client-line\">\n\n        <b>Client Name:</b>\n\n        {{ doc.customer_name or \"\" }}\n\n\n        {%- if doc.tax_id -%}\n\n            &nbsp;&nbsp;\n\n            <b>TPIN #:</b>\n\n            {{ doc.tax_id }}\n\n        {%- endif -%}\n\n    </div>\n\n\n    <!-- ============================================================\n         SECTION MACRO\n         ============================================================ -->\n\n    {%- macro render_section(title, json_field) -%}\n\n\n        {# Get JSON #}\n\n        {%- set raw = doc.get(json_field) -%}\n\n\n        {# Parse JSON #}\n\n        {%- set rows = json.loads(raw) if raw else [] -%}\n\n\n        {%- if rows and months -%}\n\n\n            <!-- ====================================================\n                 SECTION TITLE\n                 ==================================================== -->\n\n            <div class=\"gps-section-title\">\n\n                <div class=\"gps-section-title-left\">\n\n                    Statement of Subscriptions of GPS Tracking Units \u2014\n                    {{ title }}\n\n                </div>\n\n\n                <div class=\"gps-section-title-right\">\n\n                    For the month of\n                    {{ months[0].label }}\n                    to\n                    {{ months[-1].label }}\n\n                </div>\n\n            </div>\n\n\n            <!-- ====================================================\n                 TABLE\n                 ==================================================== -->\n\n            <table class=\"gps-stmt-table\">\n\n\n                <!-- ==================================================\n                     TABLE HEADER\n                     ================================================== -->\n\n                <thead>\n\n                    <tr>\n\n                        <th>\n                            Sr.<br>\n                            No.\n                        </th>\n\n\n                        <th>\n                            Unit Number\n                        </th>\n\n\n                        <th>\n                            Vehicle<br>\n                            Registration<br>\n                            Number\n                        </th>\n\n\n                        <th>\n                            Installation<br>\n                            Date\n                        </th>\n\n\n                        <th>\n                            Advance<br>\n                            Tracking<br>\n                            Unit\n                        </th>\n\n\n                        <th>\n                            Fuel<br>\n                            Level<br>\n                            Sensor\n                        </th>\n\n\n                        {%- for mo in months -%}\n\n                            <th>\n                                {{ mo.label }}\n                            </th>\n\n                        {%- endfor -%}\n\n\n                        <th>\n                            Comments\n                        </th>\n\n                    </tr>\n\n                </thead>\n\n\n                <!-- ==================================================\n                     TABLE BODY\n                     ================================================== -->\n\n                <tbody>\n\n\n                    {# =================================================\n                       NAMESPACE\n                       ================================================= #}\n\n                    {%- set ns = namespace(\n                        totals={},\n                        rates={},\n                        grand_amount=0\n                    ) -%}\n\n\n                    {# =================================================\n                       INITIALIZE MONTH TOTALS\n                       ================================================= #}\n\n                    {%- for mo in months -%}\n\n                        {%- set _ = ns.totals.update({\n                            mo.key: 0\n                        }) -%}\n\n\n                        {%- set _ = ns.rates.update({\n                            mo.key: 0\n                        }) -%}\n\n                    {%- endfor -%}\n\n\n                    {# =================================================\n                       DATA ROWS\n                       ================================================= #}\n\n                    {%- for row in rows -%}\n\n                        <tr>\n\n\n                            <!-- Sr No -->\n\n                            <td>\n                                {{ loop.index }}\n                            </td>\n\n\n                            <!-- Device Number -->\n\n                            <td class=\"left\">\n                                {{ row.device_number or \"\" }}\n                            </td>\n\n\n                            <!-- Registration -->\n\n                            <td>\n                                {{\n                                    row.registration_number\n                                    or row.vehicle_no\n                                    or \"\"\n                                }}\n                            </td>\n\n\n                            <!-- Installation Date -->\n\n                            <td>\n                                {{ row.date_of_installation or \"\" }}\n                            </td>\n\n\n                            <!-- Advance Tracking -->\n\n                            <td>\n\n                                {{ \"x\"\n                                    if row.advance_tracking_unit\n                                    else \"\"\n                                }}\n\n                            </td>\n\n\n                            <!-- Fuel Sensor -->\n\n                            <td>\n\n                                {{ \"x\"\n                                    if row.fuel_level_sensor\n                                    else \"\"\n                                }}\n\n                            </td>\n\n\n                            {# ==========================================\n                               MONTH COLUMNS\n                               ========================================== #}\n\n                            {%- for mo in months -%}\n\n\n                                {%- set checked =\n                                    row.get(mo.key)\n                                -%}\n\n\n                                <td>\n\n                                    {{ \"x\"\n                                        if checked\n                                        else \"\"\n                                    }}\n\n                                </td>\n\n\n                                {# ======================================\n                                   COUNT\n                                   ====================================== #}\n\n                                {%- if checked -%}\n\n\n                                    {%- set new_total =\n                                        ns.totals[mo.key] + 1\n                                    -%}\n\n\n                                    {%- set _ =\n                                        ns.totals.update({\n                                            mo.key: new_total\n                                        })\n                                    -%}\n\n\n                                    {# ==================================\n                                       RATE\n                                       ================================== #}\n\n                                    {%- set rate_val =\n                                        (\n                                            row.get(\n                                                mo.key ~ \"_rate\"\n                                            )\n                                            or 0\n                                        ) | float\n                                    -%}\n\n\n                                    {%- if rate_val > 0 -%}\n\n\n                                        {%- if not ns.rates[mo.key] -%}\n\n\n                                            {%- set _ =\n                                                ns.rates.update({\n                                                    mo.key: rate_val\n                                                })\n                                            -%}\n\n\n                                        {%- endif -%}\n\n\n                                    {%- endif -%}\n\n\n                                {%- endif -%}\n\n\n                            {%- endfor -%}\n\n\n                            <!-- Comments -->\n\n                            <td class=\"left\">\n\n                                {{ row.comments or \"\" }}\n\n                            </td>\n\n\n                        </tr>\n\n                    {%- endfor -%}\n\n\n                    <!-- ==================================================\n                         TOTAL COUNT\n                         ================================================== -->\n\n                    <tr class=\"gps-total-row\">\n\n\n                        <td colspan=\"6\">\n\n                            Total Count\n\n                        </td>\n\n\n                        {%- for mo in months -%}\n\n                            <td>\n\n                                {{ ns.totals[mo.key] }}\n\n                            </td>\n\n                        {%- endfor -%}\n\n\n                        <td></td>\n\n\n                    </tr>\n\n\n                    <!-- ==================================================\n                         RATE\n                         ================================================== -->\n\n                    <tr class=\"gps-total-row\">\n\n\n                        <td colspan=\"6\">\n\n                            Rate\n\n                        </td>\n\n\n                        {%- for mo in months -%}\n\n\n                            <td>\n\n\n                                {%- if ns.rates[mo.key] -%}\n\n                                    {{\n                                        frappe.utils.fmt_money(\n                                            ns.rates[mo.key],\n                                            precision=0\n                                        )\n                                    }}\n\n                                {%- else -%}\n\n                                    -\n\n                                {%- endif -%}\n\n\n                            </td>\n\n\n                        {%- endfor -%}\n\n\n                        <td></td>\n\n\n                    </tr>\n\n\n                    <!-- ==================================================\n                         AMOUNT\n                         ================================================== -->\n\n                    <tr class=\"gps-total-row\">\n\n\n                        <td colspan=\"6\">\n\n                            Amount\n\n                        </td>\n\n\n                        {%- for mo in months -%}\n\n\n                            {%- set amount =\n                                ns.totals[mo.key]\n                                * ns.rates[mo.key]\n                            -%}\n\n\n                            {%- set ns.grand_amount =\n                                ns.grand_amount + amount\n                            -%}\n\n\n                            <td>\n\n\n                                {%- if amount -%}\n\n\n                                    {{\n                                        frappe.utils.fmt_money(\n                                            amount,\n                                            precision=0\n                                        )\n                                    }}\n\n\n                                {%- else -%}\n\n\n                                    -\n\n\n                                {%- endif -%}\n\n\n                            </td>\n\n\n                        {%- endfor -%}\n\n\n                        <td></td>\n\n\n                    </tr>\n\n\n                    <!-- ==================================================\n                         VAT\n                         ================================================== -->\n\n                    {%- set vat_amount =\n                        ns.grand_amount * 0.16\n                    -%}\n\n\n                    <tr class=\"gps-vat-row\">\n\n\n                        <td colspan=\"{{ 6 + months|length }}\">\n\n                            VAT 16%\n\n                        </td>\n\n\n                        <td>\n\n\n                            {{\n                                frappe.utils.fmt_money(\n                                    vat_amount,\n                                    precision=0\n                                )\n                            }}\n\n\n                        </td>\n\n\n                    </tr>\n\n\n                    <!-- ==================================================\n                         TOTAL INCLUDING VAT\n                         ================================================== -->\n\n                    {%- set inclusive_total =\n                        ns.grand_amount + vat_amount\n                    -%}\n\n\n                    <tr class=\"gps-grandtotal-row\">\n\n\n                        <td colspan=\"{{ 6 + months|length }}\">\n\n                            Total Inclusive VAT 16%\n\n                        </td>\n\n\n                        <td>\n\n\n                            {{\n                                frappe.utils.fmt_money(\n                                    inclusive_total,\n                                    precision=0\n                                )\n                            }}\n\n\n                        </td>\n\n\n                    </tr>\n\n\n                </tbody>\n\n            </table>\n\n\n        {%- endif -%}\n\n\n    {%- endmacro -%}\n\n\n    <!-- ================================================================\n         LOCAL GPS\n         ================================================================ -->\n\n    {{ render_section(\n        \"Local\",\n        \"custom_fleet_data_json\"\n    ) }}\n\n\n    <!-- ================================================================\n         CROSS BORDER GPS\n         ================================================================ -->\n\n    {{ render_section(\n        \"Cross Border (CB)\",\n        \"custom_cb_fleet_data_json\"\n    ) }}\n\n\n</div>",
